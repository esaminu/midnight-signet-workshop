# Copy to .env (yarn doctor does this for you and fills WALLET_SEED).

# Your Midnight stagenet wallet: 64 hex chars (or a BIP-39 mnemonic).
# Fund it at https://faucet.stagenet.shielded.tools with its unshielded address
# (yarn doctor prints it). Test funds only: never reuse a real seed.
# Your identity secret (the contract's callerSecretKey witness) is derived from
# it, so this one value is also your deposit address.
WALLET_SEED=

# Any Sepolia JSON-RPC endpoint. The public one works for a workshop.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: the local app's port (yarn dev). Default 4173.
# PORT=4173
